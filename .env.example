# Copia este archivo como .env y completa los valores.
# En producción (Vercel, etc.) estas mismas variables se cargan en el panel del hosting.

# --- Base de datos (PostgreSQL) ---
# Desarrollo local: ejecuta "npm run db:dev" y usa esta dirección.
# Producción: usa la dirección de tu base en la nube (por ejemplo Neon o Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/thelovers"

# --- Panel de administración (/admin) ---
# Contraseña para entrar al panel. Usa una larga y única.
ADMIN_PASSWORD=""
# Texto largo y aleatorio (mínimo 16 caracteres) para firmar la sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# --- Archivos de los clientes (Cloudinary) ---
# Sin estos valores, en desarrollo los archivos se guardan en la carpeta .uploads;
# en producción la subida de archivos NO funciona hasta configurarlos.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Correos (Resend) ---
# Sin estos valores no se envían correos (el pedido se registra igual).
RESEND_API_KEY=""
# Remitente con un dominio verificado en Resend, por ejemplo pedidos@tudominio.pe
RESEND_FROM_EMAIL=""
# Correo donde quieres recibir el aviso de cada pedido nuevo.
ORDER_NOTIFY_EMAIL=""

# --- Sitio ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Pagos en línea (Fase 3, todavía no se usan) ---
# STRIPE_SECRET_KEY=""
# MERCADOPAGO_ACCESS_TOKEN=""
